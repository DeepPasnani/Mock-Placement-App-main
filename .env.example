# ============================================================
# Root-level environment file for docker-compose.
#
# IMPORTANT — this is DIFFERENT from backend/.env(.example):
#   - backend/.env is only read when you run the backend directly with
#     `node src/index.js` (manual/local dev, Option B in the README).
#   - When running via Docker (`docker compose up`, Option A — the
#     recommended path), backend/.env is IGNORED. It's excluded from the
#     image by backend/.dockerignore, and docker-compose.yml doesn't
#     mount it in. The only way env vars reach the backend container is
#     through the `environment:` blocks in docker-compose.yml /
#     docker-compose.prod.yml.
#   - Those blocks now pull SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS,
#     EMAIL_FROM (and a few others) from THIS file via ${VAR} Compose
#     substitution. Copy this file to `.env` at the project root (same
#     folder as docker-compose.yml) and fill in real values.
#
# If you're running the backend manually (not via Docker), edit
# backend/.env instead — this file has no effect in that case.
# ============================================================

# ── Email (needed for password-reset OTPs, test notifications, etc.) ──
# Gmail: create an App Password at https://myaccount.google.com →
# Security → App Passwords (requires 2-Step Verification enabled).
# Any other SMTP provider (SendGrid, Mailgun, your college's mail
# server, etc.) works the same way — just fill in its host/port/user/pass.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_college_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=CampusTrack <your_college_email@gmail.com>

# Leave the four SMTP_* values above blank to disable email sending
# entirely (OTP/notification emails are then silently skipped, logged as
# "SMTP not configured — emails will be skipped").

# ── Google sign-in (optional) ──────────────────────────────────
# Enables the "Sign in with Google" button on the login page. Create an
# OAuth 2.0 Client ID at https://console.cloud.google.com (APIs & Services →
# Credentials → "Web application"). Put the same value in GOOGLE_CLIENT_ID
# and in the console's "Authorized JavaScript origins" (e.g.
# http://localhost:2828 locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI features (optional) ────────────────────────────────────
# Powers AI question generation, coding hints, auto-tagging, performance
# feedback, and NL analytics in the backend. Uses any OpenAI-compatible
# chat-completions endpoint. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# PISTON_API_URL=http://piston-lb:2000/api/v2
# CODE_EXECUTION_PROVIDER=piston
