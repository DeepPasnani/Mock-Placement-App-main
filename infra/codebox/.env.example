# CodeBox Configuration
# Copy to .env and fill in values for production

# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
BODY_LIMIT=5mb

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (space-separated for multiple tokens)
AUTH_TOKEN=your-secret-token
AUTH_HEADERS=X-Auth-Token

# Execution Limits
DEFAULT_CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=15
DEFAULT_WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=30
DEFAULT_MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=512000
MAX_PROCESSES=60
MAX_SOURCE_SIZE=65536
MAX_ADDITIONAL_FILES_SIZE=2097152

# Worker
WORKER_CONCURRENCY=4

# Cache
RESULT_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Executor Type (auto | docker | firecracker)
EXECUTOR_TYPE=docker

# Docker Settings
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_TIMEOUT=30000

# One-shot containers: create/run/remove a fresh container per submission.
# Set to true only to reuse a container pool (kept for legacy deployments).
CONTAINER_POOL_ENABLED=false

# Output truncation (bytes) applied server-side to stdout/stderr.
MAX_OUTPUT_SIZE=1048576
