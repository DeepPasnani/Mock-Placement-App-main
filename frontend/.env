# ============================================================

# CampusTrack Frontend Environment Variables

# Copy this to .env and fill in values

# ============================================================

# Backend API URL

VITE\_API\_URL=http://localhost:5000/api

# WebSocket URL (same server, different protocol)

VITE\_WS\_URL=ws://localhost:5000/ws

# Google OAuth Client ID (same as backend)

# Get from [https://console.cloud.google.com](https://console.cloud.google.com/) → APIs & Services → Credentials

VITE\_GOOGLE\_CLIENT\_ID=1076160158443-62uo72dja8d59vt6tvbn9lqe1o5c4k4f.apps.googleusercontent.com

# App name (shown in UI)

VITE\_APP\_NAME=CampusTrack

# College name (shown in header/footer)

VITE\_COLLEGE\_NAME=Sardar Vallabhbhai Patel Institute of Technology, Vasad

# Dev Tools (Admin panel \> Dev Tools) — local URLs for the pgAdmin and

# self-hosted Codebox containers started via docker-compose.yml /

# infra/codebox/docker-compose.yml. Only relevant when running locally.

VITE\_PGADMIN\_URL=http://localhost:8467 VITE\_CODEBOX\_URL=http://localhost:3000

